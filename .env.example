# 复制为 .env 后按需修改；不设的项都有安全默认值。
# Windows PowerShell 里临时生效：  $env:ADMIN_PASSWORD='你的口令'; npm start

# 管理台口令。留空时服务会在 data/admin.password 生成一串随机口令，并在启动时打印文件路径
ADMIN_PASSWORD=

# 监听端口
PORT=3000

# 生产环境置 production（仅影响日志与信任代理的判断）
# NODE_ENV=production

# SQLite 数据文件位置
# DB_PATH=./data/gods-country.db

# 会话 Cookie 的 HMAC 密钥。留空时落盘到 data/session.secret
SESSION_SECRET=

# 置于 HTTPS 反向代理之后时置 1，Cookie 才会带 Secure 属性
COOKIE_SECURE=0

# 登录有效期（天）
SESSION_TTL_DAYS=7

# 单张留言图片上限（字节）
MAX_IMAGE_BYTES=5242880

# 首页服务端渲染的首批留言条数
GUESTBOOK_SSR_LIMIT=50

# 页脚「投稿」的收件邮箱
SUBMIT_MAIL=afterrainnn@outlook.com
