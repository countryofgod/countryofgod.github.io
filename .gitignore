node_modules/

# 本地环境变量与本地密钥（含管理口令），不入库
.env
.dev.vars

# 部署时临时交由本机脚本读取的凭据/代理地址：放这里是为了"万一忘了删也不会进仓库"
.cloudflare-token
.admin-passwd
.proxyrc

# wrangler 本地模拟数据与构建产物
.wrangler/
dist/

# daily/ 内容在部署前由 tools/sync-daily.mjs 复制到这里（Workers 的静态目录），不入库
public/daily/

# 运行时数据：SQLite 库、生成的口令与会话密钥都不入库
data/
*.db
*.db-wal
*.db-shm

*.log
.DS_Store
Thumbs.db
